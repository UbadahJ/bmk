# bmk completions for fish (>= 3.4). Generated by `bmk --cli fish`.
# Install: echo 'command -q bmk; and command bmk --cli fish | source' > ~/.config/fish/completions/bmk.fish

function __bmk_complete
    # -x is the fish 4.0+ spelling; older versions only have -o.
    set -l tokens (commandline -xpc 2>/dev/null; or commandline -opc)
    # The raw token keeps quotes and escapes (-t "docker,); fish matches candidates against
    # the unescaped text, so that is what bmk gets. Directories take the raw token.
    set -l raw (commandline -ct)
    set -l current (printf '%s' "$raw" | string unescape 2>/dev/null; or printf '%s' "$raw")
    # `command` skips any user function named bmk.
    set -l out (command bmk --cli __complete "$current" $tokens[2..])
    if test "$out[1]" = __BMK_DIRS__
        __fish_complete_directories "$raw"
    else if set -q out[1]
        printf '%s\n' $out
    end
end

complete -c bmk -f -a '(__bmk_complete)'
